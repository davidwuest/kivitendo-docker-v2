# kivitendo deployment config — NEON SERVERLESS POSTGRES.
# Copy to ".env" and fill in your Neon endpoint + credentials:
#   cp .env.neon-postgres.example .env
#
# The local Postgres container is NOT started for this backend.

# Database backend switch: "postgres" (local container) or "neon-postgres".
DB_BACKEND=neon-postgres

# Derives the Compose profile from the switch (the local db container carries
# the "postgres" profile, so it stays stopped here). Leave this line as-is.
COMPOSE_PROFILES=${DB_BACKEND}

# Neon connection. Use the DIRECT endpoint (no "-pooler"): kivitendo issues
# CREATE DATABASE, which cannot run through the PgBouncer pooler.
# TLS + the SNI endpoint fallback are handled automatically for *.neon.tech.
DB_HOST=ep-xxxxxxxx.eu-central-1.aws.neon.tech
DB_PORT=5432
DB_NAME=kivitendo_auth
DB_USER=neondb_owner
DB_PASSWORD=CHANGE_ME
