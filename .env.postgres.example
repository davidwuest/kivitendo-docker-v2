# kivitendo deployment config — CONVENTIONAL LOCAL POSTGRES.
# Copy to ".env" to use:   cp .env.postgres.example .env
#
# This backend works out of the box: the entrypoint fills in the local
# connection defaults, so you don't need to set the DB_* values below at all.

# Database backend switch: "postgres" (local container) or "neon-postgres".
DB_BACKEND=postgres

# Derives the Compose profile from the switch (starts the local db container
# only for DB_BACKEND=postgres). Leave this line as-is.
COMPOSE_PROFILES=${DB_BACKEND}

# Connection (optional for this backend — these are also the entrypoint
# defaults; the db container is created with the same values):
DB_HOST=db
DB_PORT=5432
DB_NAME=kivitendo
DB_USER=kivitendo
DB_PASSWORD=kivitendo
